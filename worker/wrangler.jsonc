{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neetcode30-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],

  // Durable Object (SQLite storage) làm hộp thư: mỗi mã đồng bộ = một instance,
  // Cloudflare tự tuần tự hoá request cùng mã nên đọc-rồi-ghi là atomic thật.
  // Có sẵn ở gói Workers Free, không cần nâng cấp trả phí.
  "durable_objects": {
    "bindings": [
      { "name": "SYNC_ROOM", "class_name": "SyncRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SyncRoom"] }
  ],

  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  }
}
